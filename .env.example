# ── Groq ───────────────────────────────────────────────────────────
# Powers the post-conversation FEEDBACK report (POST /api/analyze).
# Works from Hong Kong. Get one at console.groq.com.
GROQ_API_KEY=gsk_your_groq_key_here

# ── OpenAI ─────────────────────────────────────────────────────────
# Powers the LIVE realtime interview. The browser never sees this key —
# it stays on the server, which relays the OpenAI Realtime WebSocket.
# Needs a FUNDED paid account (Realtime is not in the free grant).
OPENAI_API_KEY=sk-your_openai_key_here

# Which realtime model the relay connects to.
#   gpt-realtime-mini  → ~60% cheaper, good for development
#   gpt-realtime       → best quality, for production
REALTIME_MODEL=gpt-realtime-mini

# ── Tavus ──────────────────────────────────────────────────────────
# Powers the LIVE VIDEO interview (the photoreal talking AI).
# Sign up at tavus.io (free tier = 25 min/mo). HK-friendly.
TAVUS_API_KEY=your_tavus_api_key_here
# Run `node setup-tavus.js` once — it creates the interviewer persona and
# lists stock replica faces, then prints the two ids to paste below.
# TAVUS_REPLICA_ID is required. TAVUS_PERSONA_ID is OPTIONAL — leave it blank
# to use Tavus's default persona (the call still works, just less tailored).
TAVUS_REPLICA_ID=
TAVUS_PERSONA_ID=
# Hard cap per call, in seconds (default 300 = 5 min). Your main cost guard.
TAVUS_MAX_CALL_SECONDS=300
# Optional: public URL Tavus posts conversation webhooks to (Railway URL).
# Leave blank — we also fetch the transcript on demand when the call ends.
TAVUS_CALLBACK_URL=
